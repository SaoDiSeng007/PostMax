{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostMax",
  "version": "1.0.0",
  "identifier": "cn.postmax.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/postmax-backend"],
    "shortDescription": "API 测试工具",
    "longDescription": "PostMax · 本地优先的 API 测试工具，自带后端，不需要另装 Python 或浏览器。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
